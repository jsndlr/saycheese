# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url(matches="^(?!https?://example[.]convex[.])")
NEXT_PUBLIC_CONVEX_URL=

# @public @type=url(matches="^(?!https?://example[.]convex[.])")
NEXT_PUBLIC_CONVEX_SITE_URL=

# @optional @sensitive @type=string(minLength=32)
# Shared secret the Next auth proxy sends to Convex. Convex trusts
# x-saycheese-client-ip only when this matches its own AUTH_PROXY_SECRET.
AUTH_PROXY_SECRET=
